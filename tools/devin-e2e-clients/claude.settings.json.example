{
  "env": {
    "ANTHROPIC_BASE_URL": "http://127.0.0.1:REPLACE_PORT",
    "ANTHROPIC_MODEL": "REPLACE_WITH_DISCOVERED_MODEL_UID",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "REPLACE_WITH_DISCOVERED_MODEL_UID",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "REPLACE_WITH_DISCOVERED_MODEL_UID",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "REPLACE_WITH_DISCOVERED_MODEL_UID",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1"
  },
  "permissions": {
    "allow": ["Read(./probe.txt)"],
    "deny": ["Bash", "Write", "Edit", "WebFetch", "WebSearch"]
  }
}
